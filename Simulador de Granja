#include <stdio.h>

int tableroColumnas = 7;
int tableroFilas = 8;


char tablero[8][7];
int jugador= 1;
void inicializarTablero(){
    for(int i=0; i<tableroFilas; i++){
        for(int j=0; j<tableroColumnas; j++){
            tablero[i][j] = ' ';
        }
    }
}

void mostrarTablero(){
     for(int i=0; i<tableroColumnas; i++){
        printf("| %d", i + 1);
    }
    printf("\n");
    
    
    for(int i=0; i<tableroFilas; i++){
        for(int j=0; j<tableroColumnas; j++){
            printf("| %c", tablero[i][j]);
        }
        printf("|\n");
    }
}
int main()
{
    inicializarTablero();
    mostrarTablero();

    return 0;
}
